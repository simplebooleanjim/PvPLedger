# Create a Battle.net API client at https://develop.battle.net/access/clients
# Copy this file to .env and replace the placeholders below.
#
# For local development:
#   Copy to Collector/.env
#
# For GitHub Actions automation, add the same values as repository secrets:
#   BNET_CLIENT_ID
#   BNET_CLIENT_SECRET
BNET_CLIENT_ID=your_client_id_here
BNET_CLIENT_SECRET=your_client_secret_here
